# Preferred production backend: Qwen3.5-4B behind vLLM/SGLang/Transformers Serve.
HOARE_LLM_BACKEND=auto
HOARE_LLM_MODEL=Qwen/Qwen3.5-4B
HOARE_LLM_BASE_URL=http://127.0.0.1:8000/v1
HOARE_LLM_API_KEY=EMPTY
HOARE_LLM_TIMEOUT_SECONDS=180
HOARE_MAX_OUTPUT_TOKENS=6144

# If you already downloaded Qwen3.5-4B locally, leave HOARE_LLM_BASE_URL empty
# and point this at the model directory. Hoare AI lazy-loads it with Transformers.
HOARE_QWEN_MODEL_PATH=

# Set true only when the app should download Qwen3.5-4B from the Hub itself.
# Hugging Face Spaces are auto-detected and can do this when hardware is sufficient.
HOARE_LOAD_MODEL_FROM_HUB=false

# Optional fallback: Gemini. Used only when HOARE_LLM_BACKEND=gemini or auto selects it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_GENAI_USE_ENTERPRISE=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# GitHub PR ingestion (required for private repositories).
GITHUB_TOKEN=

# Persistent quality memory on GCP: project.dataset.table
HOARE_BIGQUERY_TABLE=

# Local fallback history store.
HOARE_SQLITE_PATH=/tmp/hoare_ai.db

# Keep false in production. HF OAuth or Cloud Run IAP identifies users.
HOARE_ALLOW_ANONYMOUS=false
HOARE_CONCURRENCY=2
