# Gemini Developer API (local / Hugging Face)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Or Gemini on Google Cloud
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=us-central1

# Optional GitHub PR review support
GITHUB_TOKEN=

# Optional BigQuery sink: project.dataset.table
HOARE_BIGQUERY_TABLE=

# Local / Hugging Face fallback history store
HOARE_SQLITE_PATH=/tmp/hoare_ai.db

# Keep false in production. HF OAuth or Cloud Run IAP identifies users.
HOARE_ALLOW_ANONYMOUS=false
